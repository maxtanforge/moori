# moori-agent 镜像（设计 13 / M5 双镜像优化）：
#   只包含 Agent 二进制、Docker CLI、Compose 插件、CA、tzdata；不含前端
#   资源与 Git（设计 L380）。Docker CLI 与 Compose 插件 COPY 自官方
#   docker:cli 镜像（版本标签钉版；发布演练时可在 CI 中把标签固化为
#   digest）。容器内经挂载的 docker.sock 执行 `docker` / `docker compose`
#   （设计 4.3：节点侧官方 CLI，中心不重新实现编排）。
#   更小的独立 Agent 二进制（systemd 方式）由 `make release-agent` 单独
#   产出，见 docs/deployment.md。
#   构建上下文 = 仓库根目录：docker build -f deploy/Dockerfile.agent .

########## 阶段 1：Agent 二进制（纯 Go）
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ARG GITCOMMIT=unknown
ENV CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath \
    -ldflags "-s -w \
      -X github.com/maxtanforge/moori/internal/version.Version=${VERSION} \
      -X github.com/maxtanforge/moori/internal/version.GitCommit=${GITCOMMIT}" \
    -o /out/moori-agent ./cmd/moori-agent

########## 阶段 2：运行镜像
FROM alpine:3.22 AS final
RUN apk add --no-cache ca-certificates tzdata
# docker:cli 变体自带 CLI 与 buildx/compose 插件；只取 CLI 与 Compose
# 部署使用 CI 已发布镜像，本地不构建镜像，不携带 buildx。
# CLI 探查插件的固定路径之一：/usr/local/libexec/docker/cli-plugins。
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:28-cli /usr/local/libexec/docker/cli-plugins/docker-compose \
     /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=build /out/moori-agent /usr/local/bin/moori-agent
ENV MOORI_DATA_DIR=/data
WORKDIR /data
VOLUME /data
ENTRYPOINT ["moori-agent"]
# Configure MOORI_ENDPOINT and MOORI_AGENT_TOKEN in Compose.
